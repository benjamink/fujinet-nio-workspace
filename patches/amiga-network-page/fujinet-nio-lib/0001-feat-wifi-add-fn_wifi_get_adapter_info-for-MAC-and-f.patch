From c9d3505d5fe90498f844e22f4bfdef1757264857 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 2 Oct 2026 19:53:44 +0000
Subject: [PATCH] feat(wifi): add fn_wifi_get_adapter_info for MAC and firmware
 version

Client call for Wi-Fi service command GET_ADAPTER_INFO (0x05): returns the
station MAC (with a valid flag) and the firmware version string. Firmware
without the command yields FN_ERR_UNSUPPORTED so config tools can show the
fields as unknown. Common and BBC implementations live in their own
fn_wifi_adapter.c files so programs that do not use it do not link it.

Verification: make check (all 9 targets: atari, bbc, bbc-clib,
msdos-serial/ioctl/f5, linux, amiga, amiga-driver; all host wire tests,
including new adapter-info success, Unsupported and malformed-length cases).

Claude-Session: https://claude.ai/code/session_01WnuNydgtRyXCoECm974X7F
---
 include/fn_protocol.h              |  1 +
 include/fujinet-nio.h              |  8 ++++++
 makefiles/build.mk                 |  4 +--
 src/common/fn_wifi_adapter.c       | 31 ++++++++++++++++++++
 src/platform/bbc/fn_wifi_adapter.c | 31 ++++++++++++++++++++
 tests/run_wifi_wire_test.sh        |  1 +
 tests/wifi_wire_test.c             | 45 ++++++++++++++++++++++++++++++
 7 files changed, 119 insertions(+), 2 deletions(-)
 create mode 100644 src/common/fn_wifi_adapter.c
 create mode 100644 src/platform/bbc/fn_wifi_adapter.c

diff --git a/include/fn_protocol.h b/include/fn_protocol.h
index 145739f..9829daf 100644
--- a/include/fn_protocol.h
+++ b/include/fn_protocol.h
@@ -91,6 +91,7 @@ extern "C" {
 #define FN_WIFI_CMD_GET_CONFIG   0x02
 #define FN_WIFI_CMD_SET_CONFIG   0x03
 #define FN_WIFI_CMD_SCAN         0x04
+#define FN_WIFI_CMD_GET_ADAPTER_INFO 0x05
 
 /* ============================================================================
  * Clock Device Commands
diff --git a/include/fujinet-nio.h b/include/fujinet-nio.h
index 19946ce..57bed19 100644
--- a/include/fujinet-nio.h
+++ b/include/fujinet-nio.h
@@ -115,6 +115,7 @@ extern "C" {
 #define FN_WIFI_MAX_BSSID     17
 #define FN_WIFI_MAX_PASSWORD  64
 #define FN_WIFI_MAX_SCAN_RECORDS 32
+#define FN_WIFI_MAX_FIRMWARE_VERSION 32
 #define FN_WIFI_SCAN_RESPONSE_HEADER_SIZE 3
 #define FN_WIFI_SCAN_RECORD_WIRE_MAX (1 + FN_WIFI_MAX_SSID + 9)
 #define FN_WIFI_SCAN_RESPONSE_MAX \
@@ -164,11 +165,18 @@ typedef struct {
     int8_t rssi;
     uint8_t channel, auth;
 } fn_wifi_scan_record_t;
+typedef struct {
+    fn_wifi_bssid_t mac;    /* station interface MAC; mac.valid=0 when unknown */
+    char firmware[FN_WIFI_MAX_FIRMWARE_VERSION + 1];
+} fn_wifi_adapter_info_t;
 
 /* Password input is consumed during the call and is never returned. */
 uint8_t fn_wifi_get_status(fn_wifi_status_t *status);
 uint8_t fn_wifi_get_config(fn_wifi_config_t *config);
 uint8_t fn_wifi_set_config(const fn_wifi_config_update_t *update);
+/* Station MAC and firmware version. Firmware that predates the command
+ * returns FN_ERR_UNSUPPORTED; callers should show the fields as unknown. */
+uint8_t fn_wifi_get_adapter_info(fn_wifi_adapter_info_t *info);
 /* offset is a record index; limit/capacity are bounded to 32 records and
  * count is the number written to records. response_buffer is caller-owned
  * scratch storage used for the wire response. The helper reduces the wire
diff --git a/makefiles/build.mk b/makefiles/build.mk
index 1c36dba..8331f73 100644
--- a/makefiles/build.mk
+++ b/makefiles/build.mk
@@ -90,7 +90,7 @@ COMMON_SRCS_DEFAULT := $(SRCDIR)/common/fn_slip.c \
                        $(SRCDIR)/common/fn_format_mount_display.c \
                        $(SRCDIR)/common/fn_disk.c \
                        $(SRCDIR)/common/fn_raw.c
-COMMON_SRCS_DEFAULT += $(SRCDIR)/common/fn_wifi.c
+COMMON_SRCS_DEFAULT += $(SRCDIR)/common/fn_wifi.c $(SRCDIR)/common/fn_wifi_adapter.c
 
 LEGACY_SRCS_DEFAULT := $(SRCDIR)/legacy/fn_legacy_appkey_state.c \
                        $(SRCDIR)/legacy/fn_legacy_appkey_util.c \
@@ -125,7 +125,7 @@ COMMON_SRCS_BBC := $(SRCDIR)/common/fn_util.c \
                    $(SRCDIR)/common/fn_mount_resolve_build.c \
                    $(SRCDIR)/common/fn_resolve_mount_target.c \
                     $(SRCDIR)/common/fn_format_mount_display.c
-COMMON_SRCS_BBC += $(SRCDIR)/platform/bbc/fn_wifi.c
+COMMON_SRCS_BBC += $(SRCDIR)/platform/bbc/fn_wifi.c $(SRCDIR)/platform/bbc/fn_wifi_adapter.c
 
 # BBC fn_appstore_read/write are supplied by platform/bbc assembly sources.
 # Other platforms retain the portable implementations in COMMON_SRCS_DEFAULT.
diff --git a/src/common/fn_wifi_adapter.c b/src/common/fn_wifi_adapter.c
new file mode 100644
index 0000000..4d18f5a
--- /dev/null
+++ b/src/common/fn_wifi_adapter.c
@@ -0,0 +1,31 @@
+#include <string.h>
+#include "fn_protocol.h"
+#include "fn_raw.h"
+#include "fujinet-nio.h"
+
+/* Kept apart from fn_wifi.c so programs that do not show adapter details do
+ * not link it. Reply: version, MAC-present, MAC[6], firmware length, text. */
+uint8_t fn_wifi_get_adapter_info(fn_wifi_adapter_info_t *info) {
+    uint8_t req[] = {FN_WIFI_PROTOCOL_VERSION};
+    uint8_t reply[9 + FN_WIFI_MAX_FIRMWARE_VERSION], result, n;
+    uint16_t len;
+    fn_raw_response_t r;
+    if (!info) return FN_ERR_INVALID;
+    result = fn_raw_call(FN_DEVICE_WIFI, FN_WIFI_CMD_GET_ADAPTER_INFO, req, 1,
+                         reply, sizeof(reply), &r);
+    if (result != FN_OK) return result;
+    if (r.status == 2) return FN_ERR_INVALID;
+    if (r.status == 4) return FN_ERR_NOT_READY;
+    if (r.status == 8) return FN_ERR_UNSUPPORTED;
+    if (r.status != 0) return FN_ERR_IO;
+    len = r.payload_length;
+    if (len < 9 || reply[0] != FN_WIFI_PROTOCOL_VERSION) return FN_ERR_IO;
+    n = reply[8];
+    if (n > FN_WIFI_MAX_FIRMWARE_VERSION || (uint16_t)(9 + n) != len) return FN_ERR_IO;
+    memset(info, 0, sizeof(*info));
+    info->mac.valid = reply[1] ? 1 : 0;
+    memcpy(info->mac.bytes, reply + 2, 6);
+    memcpy(info->firmware, reply + 9, n);
+    info->firmware[n] = 0;
+    return FN_OK;
+}
diff --git a/src/platform/bbc/fn_wifi_adapter.c b/src/platform/bbc/fn_wifi_adapter.c
new file mode 100644
index 0000000..7295ee8
--- /dev/null
+++ b/src/platform/bbc/fn_wifi_adapter.c
@@ -0,0 +1,31 @@
+#include <string.h>
+
+#include "fn_bbc_internal.h"
+#include "fn_protocol.h"
+#include "fujinet-nio.h"
+
+/* Kept apart from fn_wifi.c so programs that do not show adapter details do
+ * not link it. Reply: version, MAC-present, MAC[6], firmware length, text. */
+uint8_t fn_wifi_get_adapter_info(fn_wifi_adapter_info_t *info)
+{
+    uint8_t req[] = {FN_WIFI_PROTOCOL_VERSION};
+    uint8_t reply[9 + FN_WIFI_MAX_FIRMWARE_VERSION], result, n, status = FN_ERR_INTERNAL;
+    uint16_t len = 0;
+    if (!info) return FN_ERR_INVALID;
+    result = fn_bbc_device_call_raw(FN_DEVICE_WIFI, FN_WIFI_CMD_GET_ADAPTER_INFO, req, 1,
+                                    reply, sizeof(reply), &status, &len);
+    if (result != FN_OK) return result;
+    if (status == 2) return FN_ERR_INVALID;
+    if (status == 4) return FN_ERR_NOT_READY;
+    if (status == 8) return FN_ERR_UNSUPPORTED;
+    if (status != 0) return FN_ERR_IO;
+    if (len < 9 || reply[0] != FN_WIFI_PROTOCOL_VERSION) return FN_ERR_IO;
+    n = reply[8];
+    if (n > FN_WIFI_MAX_FIRMWARE_VERSION || (uint16_t)(9 + n) != len) return FN_ERR_IO;
+    memset(info, 0, sizeof(*info));
+    info->mac.valid = reply[1] ? 1 : 0;
+    memcpy(info->mac.bytes, reply + 2, 6);
+    memcpy(info->firmware, reply + 9, n);
+    info->firmware[n] = 0;
+    return FN_OK;
+}
diff --git a/tests/run_wifi_wire_test.sh b/tests/run_wifi_wire_test.sh
index a559906..cdb0246 100644
--- a/tests/run_wifi_wire_test.sh
+++ b/tests/run_wifi_wire_test.sh
@@ -9,5 +9,6 @@ gcc -std=c99 -Wall -Wextra -Werror \
     -I"$ROOT/include" \
     "$ROOT/tests/wifi_wire_test.c" \
     "$ROOT/src/common/fn_wifi.c" \
+    "$ROOT/src/common/fn_wifi_adapter.c" \
     -o "$OUT"
 "$OUT"
diff --git a/tests/wifi_wire_test.c b/tests/wifi_wire_test.c
index c900c06..0482754 100644
--- a/tests/wifi_wire_test.c
+++ b/tests/wifi_wire_test.c
@@ -12,6 +12,8 @@ static uint8_t last_command;
 static uint8_t last_payload[256];
 static uint16_t last_payload_len;
 static unsigned call_count;
+static uint8_t adapter_status;
+static uint8_t adapter_firmware_len_override;
 
 static void put_string(uint8_t *out, uint16_t *at, const char *value)
 {
@@ -87,6 +89,22 @@ uint8_t fn_raw_call(uint8_t device,
         return FN_OK;
     }
 
+    if (command == FN_WIFI_CMD_GET_ADAPTER_INFO) {
+        if (payload_length != 1 || last_payload[0] != FN_WIFI_PROTOCOL_VERSION)
+            return FN_ERR_INVALID;
+        response->status = adapter_status;
+        if (adapter_status) return FN_OK;
+        if (reply_capacity < 9 + 6) return FN_ERR_INVALID;
+        out[at++] = FN_WIFI_PROTOCOL_VERSION;
+        out[at++] = 1;
+        out[at++] = 0x24; out[at++] = 0x6F; out[at++] = 0x28;
+        out[at++] = 0x01; out[at++] = 0x02; out[at++] = 0x03;
+        put_string(out, &at, "0.1.1");
+        if (adapter_firmware_len_override) out[8] = adapter_firmware_len_override;
+        response->payload_length = at;
+        return FN_OK;
+    }
+
     if (command == FN_WIFI_CMD_SCAN) {
         uint8_t requested = last_payload[3];
         if (payload_length != 4 || last_payload[0] != FN_WIFI_PROTOCOL_VERSION)
@@ -189,11 +207,38 @@ static int test_scan_and_boundaries(void)
     return 0;
 }
 
+static int test_adapter_info(void)
+{
+    fn_wifi_adapter_info_t info;
+
+    reset_call();
+    adapter_status = 0;
+    adapter_firmware_len_override = 0;
+    if (fn_wifi_get_adapter_info(&info) != FN_OK) return 1;
+    if (last_command != FN_WIFI_CMD_GET_ADAPTER_INFO || last_payload_len != 1) return 1;
+    if (!info.mac.valid || info.mac.bytes[0] != 0x24 || info.mac.bytes[5] != 0x03) return 1;
+    if (strcmp(info.firmware, "0.1.1") != 0) return 1;
+
+    /* Firmware without the command answers Unsupported (wire status 8). */
+    adapter_status = 8;
+    if (fn_wifi_get_adapter_info(&info) != FN_ERR_UNSUPPORTED) return 1;
+
+    /* A length byte that disagrees with the payload is rejected. */
+    adapter_status = 0;
+    adapter_firmware_len_override = 9;
+    if (fn_wifi_get_adapter_info(&info) != FN_ERR_IO) return 1;
+    adapter_firmware_len_override = 0;
+
+    if (fn_wifi_get_adapter_info(0) != FN_ERR_INVALID) return 1;
+    return 0;
+}
+
 int main(void)
 {
     if (test_status()) { puts("wifi status wire test failed"); return 1; }
     if (test_config_and_set()) { puts("wifi config wire test failed"); return 1; }
     if (test_scan_and_boundaries()) { puts("wifi scan wire test failed"); return 1; }
+    if (test_adapter_info()) { puts("wifi adapter info wire test failed"); return 1; }
     puts("wifi wire tests passed");
     return 0;
 }
