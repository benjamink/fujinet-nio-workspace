C:Assign T: RAM:
C:FailAt 100
C:fujinet-load-resident >DH0:w13fail-load.result DEVS:fujinet-disk.device fujinet-disk.device
C:Mount DN0:
C:Mount DN2:
C:FMOUNT >DH0:w13fail-dn0-mount.result 11 DN0: RO
If NOT WARN
C:FMOUNT >DH0:w13fail-dn2-invalid.result 99 DN2: RO
If NOT WARN
C:Echo >>DH0:w13fail-dn2-invalid.result "INVALID UNEXPECTED SUCCESS"
Else
C:Echo >>DH0:w13fail-dn2-invalid.result "INVALID REJECTED"
EndIf
C:Type >DH0:w13fail-dn0-type.result DN0:KNOWN.TXT
C:fujinet-mount >DH0:w13fail-dn0-status.result --status 0
C:FUMOUNT >DH0:w13fail-dn0-eject.result DN0:
C:fujinet-nio-exchange --type file-list --backend cold --baud 38400 --size 256 --trials 1 --uri host:/amiga-e2e-complete/diskdevice-wb13-failed-secondary-mount
EndIf
