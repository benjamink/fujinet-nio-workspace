C:Assign T: RAM:
C:FailAt 100
C:Echo >DH0:nio-stage.result "before-seed"
C:Echo >NATIVE:host-fs/native-exchange.txt "seed"
C:Echo >DH0:nio-seed.result "SEED RC=0"
C:Echo >>DH0:nio-stage.result "before-load"
C:fujinet-load-resident DEVS:fujinet-nio.device fujinet-nio.device
If NOT WARN
C:Echo >DH0:nio-load.result "LOAD RC=0"
Else
C:Echo >DH0:nio-load.result "LOAD RC=20"
EndIf
C:Echo >>DH0:nio-stage.result "after-load"
C:Wait 3
C:Echo >>DH0:nio-stage.result "before-clock"
C:fujinet-nio-exchange >DH0:nio-clock.result --installed-backend native --backend warm --type clock --trials 2
If NOT WARN
C:Echo >>DH0:nio-clock.result "RC=0"
Else
C:Echo >>DH0:nio-clock.result "RC=20"
EndIf
C:Echo >>DH0:nio-stage.result "after-clock"
C:fujinet-nio-exchange >DH0:nio-list.result --installed-backend native --backend warm --type file-list --uri host:/ --size 128 --trials 2
If NOT WARN
C:Echo >>DH0:nio-list.result "RC=0"
Else
C:Echo >>DH0:nio-list.result "RC=20"
EndIf
C:Echo >>DH0:nio-stage.result "after-list"
C:Echo >NATIVE:complete "PASS"
