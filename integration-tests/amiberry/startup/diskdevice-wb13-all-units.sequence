C:Assign T: RAM:
C:Failat 100
C:fujinet-load-resident >DH0:w13u-load.result DEVS:fujinet-disk.device fujinet-disk.device
C:FMOUNT >DH0:w13u-dn0m.result 11 DO0: RO
If NOT WARN
C:FMOUNT >DH0:w13u-dn1m.result 11 DO1: RO
If NOT WARN
C:Type >DH0:w13u-dn0t.result DO0:KNOWN.TXT
C:Type >DH0:w13u-dn1t.result DO1:KNOWN.TXT
C:fujinet-nio-exchange --type file-list --backend cold --baud 38400 --size 256 --trials 1 --uri host:/amiga-e2e-complete/diskdevice-wb13-all-units
EndIf
EndIf
