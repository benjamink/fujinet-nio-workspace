C:Assign T: RAM:
C:fujinet-load-resident DEVS:fujinet-nio.device fujinet-nio.device
C:Wait 3
C:FHOST >DH0:cli-fhost-set.result host:/
C:FHOST >DH0:cli-fhost-get.result
C:FLS >DH0:cli-fls.result host:/
C:FAPP >DH0:cli-fapp-delete-old.result DEL nio.e2e value
C:FAPP >DH0:cli-fapp-put.result PUT nio.e2e value hello
C:FAPP >DH0:cli-fapp-get.result GET nio.e2e value
C:FAPP >DH0:cli-fapp-list.result LIST nio.e2e
C:FAPP >DH0:cli-fapp-delete.result DEL nio.e2e value
C:FLS host:/amiga-e2e-complete/cli-stateful
