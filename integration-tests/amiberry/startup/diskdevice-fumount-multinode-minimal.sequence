C:Assign T: RAM:
C:Echo "FUJINET WRITE PERSISTED" >DH0:multinode-source.txt
C:FailAt 21
C:fujinet-load-resident DEVS:fujinet-disk.device fujinet-disk.device
C:Echo "LOAD RC=$RC" >DH0:multinode-load.result
C:FMOUNT 11 DN0: RO >DH0:multinode-dn0-mount.result
C:Echo "DN0 MOUNT RC=$RC" >>DH0:multinode-dn0-mount.result
C:Type DN0:KNOWN.TXT >DH0:multinode-dn0-type.result
C:Echo "DN0 TYPE RC=$RC" >>DH0:multinode-dn0-type.result
C:FMOUNT 13 DN2: RW >DH0:multinode-dn2-mount.result
C:Echo "DN2 MOUNT RC=$RC" >>DH0:multinode-dn2-mount.result
C:Copy DH0:multinode-source.txt TO DN2:PERSIST.TXT
C:Echo "DN2 COPY RC=$RC" >DH0:multinode-dn2-copy.result
C:FUMOUNT DN2: >DH0:multinode-dn2-fumount.result
C:Echo "DN2 FUMOUNT RC=$RC" >>DH0:multinode-dn2-fumount.result
C:FMOUNT 13 DN2: RW >DH0:multinode-dn2-remount.result
C:Echo "DN2 REMOUNT RC=$RC" >>DH0:multinode-dn2-remount.result
C:Type DN2:PERSIST.TXT >DH0:multinode-dn2-persist.result
C:Echo "DN2 PERSIST RC=$RC" >>DH0:multinode-dn2-persist.result
C:FUMOUNT DN0: >DH0:multinode-dn0-fumount.result
C:Echo "DN0 FUMOUNT RC=$RC" >>DH0:multinode-dn0-fumount.result
C:lockdiag >DH0:multinode-lockdiag.result
C:fujinet-mount --status 0 >DH0:multinode-dn0-status.result
C:FLS host:/amiga-e2e-complete/diskdevice-fumount-multinode-minimal >DH0:multinode-completion.result
C:Echo "E2E COMPLETE"
