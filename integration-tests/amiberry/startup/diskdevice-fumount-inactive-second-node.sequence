C:Assign T: RAM:
C:FailAt 21
C:fujinet-load-resident DEVS:fujinet-disk.device fujinet-disk.device
C:FMOUNT 11 DN0: RO >DH0:inode-dn0-mount.result
C:Echo "DN0 MOUNT RC=$RC" >>DH0:inode-dn0-mount.result
C:Type DN0:KNOWN.TXT >DH0:inode-dn0-type.result
C:Echo "DN0 TYPE RC=$RC" >>DH0:inode-dn0-type.result
C:FMOUNT 13 DN2: RW >DH0:inode-dn2-mount.result
C:Echo "DN2 MOUNT RC=$RC" >>DH0:inode-dn2-mount.result
C:doslistdiag >DH0:inode-dos.result
C:FUMOUNT DN0: >DH0:inode-dn0-fumount.result
C:Echo "DN0 FUMOUNT RC=$RC" >>DH0:inode-dn0-fumount.result
C:lockdiag >DH0:inode-lockdiag.result
C:FLS host:/amiga-e2e-complete/diskdevice-fumount-inactive-second-node >DH0:inode-completion.result
C:Echo "E2E COMPLETE"
