C:Assign T: RAM:
C:Failat 100
C:Echo >DH0:wb13-persist-source.txt "FUJINET WB13 WRITE PERSISTED"
C:fujinet-load-resident >DH0:wb13-multi-load.result DEVS:fujinet-disk.device fujinet-disk.device
C:Mount DN0:
C:Mount DN2:
C:FMOUNT >DH0:wb13-multi-dn0-mount.result 11 DN0: RO
If NOT WARN
C:Type >DH0:wb13-multi-dn0-type.result DN0:KNOWN.TXT
If NOT WARN
C:FMOUNT >DH0:wb13-multi-dn2-mount.result 13 DN2: RW
If NOT WARN
C:fujinet-mount >DH0:wb13-multi-dn2-status.result --status 2
C:Failat 100
C:Copy DH0:wb13-persist-source.txt TO DN2:PERSIST.TXT
C:Echo >DH0:wb13-multi-copy.result "COPY RC=$RC"
If NOT WARN
C:FUMOUNT >DH0:wb13-multi-dn2-eject.result DN2:
If NOT WARN
C:FMOUNT >DH0:wb13-multi-dn2-remount.result 13 DN2: RW
If NOT WARN
C:Type >DH0:wb13-multi-persist.result DN2:PERSIST.TXT
If NOT WARN
C:FUMOUNT >DH0:wb13-multi-dn0-eject.result DN0:
If NOT WARN
C:FUMOUNT >DH0:wb13-multi-dn2-finale.result DN2:
If NOT WARN
C:fujinet-nio-exchange --type file-list --backend cold --baud 38400 --size 256 --trials 1 --uri host:/amiga-e2e-complete/diskdevice-wb13-multidrive
EndIf
EndIf
EndIf
EndIf
EndIf
EndIf
EndIf
EndIf
EndIf
EndIf
