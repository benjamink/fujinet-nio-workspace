C:Assign T: RAM:
C:FailAt 21
C:fujinet-load-resident DEVS:fujinet-nio.device fujinet-nio.device
C:fujinet-load-resident >DH0:loader.result DEVS:fujinet-disk.device fujinet-disk.device
If NOT WARN
C:Echo >>DH0:loader.result "FIRST RC=0"
C:fujinet-load-resident >DH0:loader-second.result DEVS:fujinet-disk.device fujinet-disk.device
If NOT WARN
C:Echo >>DH0:loader-second.result "SECOND RC=0"
C:fujinet-load-resident >DH0:loader-mismatch.result DEVS:fujinet-disk.device wrong-resident.device
If WARN
C:Echo >>DH0:loader-mismatch.result "MISMATCH RC=20"
C:fujinet-load-resident >DH0:loader-invalid.result C:wifitest wrong-resident.device
If WARN
C:Echo >>DH0:loader-invalid.result "INVALID RC=20"
C:fujinet-mount >DH0:loader-status.result --status 0
C:fujinet-nio-exchange --type file-list --backend cold --baud 38400 --size 256 --trials 1 --uri host:/amiga-e2e-complete/diskdevice-loader
EndIf
EndIf
EndIf
EndIf
