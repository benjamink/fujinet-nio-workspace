C:Assign T: RAM:
C:Failat 100
C:fujinet-load-resident >DH0:wb13mix-load.result DEVS:fujinet-disk.device fujinet-disk.device
C:Mount DN0:
C:Mount HD0:
C:FIN 13 host:/writable.adf
If NOT WARN
C:FIN 21 host:/hd-writable.adf
If NOT WARN
C:FMOUNT >DH0:wb13mix-dd-mount.result 13 DN0: RW
If NOT WARN
C:FMOUNT >DH0:wb13mix-hd-mount.result 21 HD0: RW
If NOT WARN
C:Copy >DH0:wb13mix-dd-to-hd.result DN0:BASE.TXT TO HD0:FROMDD.TXT
If NOT WARN
C:Copy >DH0:wb13mix-hd-to-dd.result HD0:BASEHD.TXT TO DN0:FROMHD.TXT
If NOT WARN
C:Type >DH0:wb13mix-hd-copy.result HD0:FROMDD.TXT
C:Type >DH0:wb13mix-dd-copy.result DN0:FROMHD.TXT
C:FUMOUNT >DH0:wb13mix-hd-eject.result HD0:
If NOT WARN
C:FMOUNT >DH0:wb13mix-hd-remount.result 21 HD0: RW
If NOT WARN
C:Type >DH0:wb13mix-hd-persist.result HD0:FROMDD.TXT
If NOT WARN
C:fujinet-nio-exchange --type file-list --backend cold --baud 38400 --size 256 --trials 1 --uri host:/amiga-e2e-complete/diskdevice-wb13-mixed-hd
EndIf
EndIf
EndIf
EndIf
