C:Type >DH0:wb13mix-dd-copy.result DO0:FROMHD.TXT
C:FUMOUNT >DH0:wb13mix-hd-eject.result 1
If NOT WARN
C:FMOUNT >DH0:wb13mix-hd-remount.result 21 1 RW
If NOT WARN
C:Type >DH0:wb13mix-hd-persist.result HO1:FROMDD.TXT
If NOT WARN
C:fujinet-nio-exchange --type file-list --backend cold --baud 38400 --size 256 --trials 1 --uri host:/amiga-e2e-complete/diskdevice-wb13-mixed-hd
