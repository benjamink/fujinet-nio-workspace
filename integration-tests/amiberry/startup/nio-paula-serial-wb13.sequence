C:Assign T: RAM:
C:FailAt 100
C:fujinet-load-resident >DH0:serial-load.result DEVS:fujinet-serial.device fujinet-serial.device
If NOT WARN
C:Echo >>DH0:serial-load.result "SERIAL LOAD RC=0"
C:fujinet-load-resident >DH0:nio-load.result DEVS:fujinet-nio.device fujinet-nio.device
If NOT WARN
C:Echo >>DH0:nio-load.result "LOAD RC=0"
C:fujinet-nio-exchange >DH0:nio-exchange.result --type clock --backend cold --baud 19200 --trials 1 --serial-device fujinet-serial.device
If NOT WARN
C:Echo >DH0:nio-tool-rc.result "TOOL RC=0"
Else
C:Echo >DH0:nio-tool-rc.result "TOOL RC=20"
EndIf
C:fujinet-nio-exchange >NIL: --type file-list --backend cold --baud 19200 --trials 1 --size 256 --uri host:/amiga-e2e-complete/nio-paula-serial --serial-device fujinet-serial.device
EndIf
EndIf
C:Type DH0:serial-load.result
C:Type DH0:nio-load.result
C:Type DH0:nio-exchange.result
C:Type DH0:nio-tool-rc.result
