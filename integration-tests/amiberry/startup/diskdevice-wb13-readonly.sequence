C:Assign T: RAM:
C:Failat 100
C:fujinet-load-resident DEVS:fujinet-disk.device fujinet-disk.device
C:FMOUNT >DH0:w13wp-mount.result 11 0 RO
If NOT WARN
C:fujinet-mount >DH0:w13wp-status.result --status 0
C:Type >DH0:w13wp-known.result DO0:KNOWN.TXT
If NOT WARN
C:fujinet-nio-exchange --type file-list --backend cold --baud 38400 --size 256 --trials 1 --uri host:/amiga-e2e-complete/diskdevice-wb13-readonly
EndIf
EndIf
