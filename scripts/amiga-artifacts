#!/usr/bin/env bash
# Build self-contained Amiga artifact profiles.  Profiles never share object
# or executable directories, so a release cannot accidentally use whichever
# CRT was built most recently.
set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
PROFILE="${1:-}"

case "$PROFILE" in
  wb13) CRT=nix13; WB13=1 ;;
  wb31|wb32) CRT=clib2; WB13=0 ;;
  *)
    echo "Usage: scripts/amiga-artifacts wb13|wb31|wb32" >&2
    exit 2
    ;;
esac

source "$ROOT/scripts/env.sh"

DRIVER_BUILD="$ROOT/repos/fujinet-nio-driver/build/amiga/$PROFILE"
DRIVER_BUILD_REL="../build/amiga/$PROFILE"
CORE_BUILD="$ROOT/repos/nio-core-apps/build/amiga/$PROFILE"
APPS_BUILD="$ROOT/repos/nio-apps/build/amiga/$PROFILE"
STAGE="$ROOT/build/amiga-artifacts/$PROFILE/NIO"

make -C "$ROOT/repos/fujinet-nio-driver/amiga" \
  "BUILD_DIR=$DRIVER_BUILD_REL" \
  "AMIGA_WB13=$WB13" \
  "$DRIVER_BUILD_REL/fujinet-nio.device" \
  "$DRIVER_BUILD_REL/fujinet-disk.device" \
  "$DRIVER_BUILD_REL/fujinet-serial.device" \
  "$DRIVER_BUILD_REL/fujinet-load-resident" \
  "$DRIVER_BUILD_REL/fujinet-mount" \
  "$DRIVER_BUILD_REL/fujinet-nio-exchange" \
  sdk resident-artifacts
if [[ "$PROFILE" != wb13 ]]; then
  make -C "$ROOT/repos/fujinet-nio-driver/amiga" \
    "BUILD_DIR=$DRIVER_BUILD_REL" \
    "AMIGA_WB13=$WB13" \
    "$DRIVER_BUILD_REL/fujinet-unload-resident" \
    "$DRIVER_BUILD_REL/fujinet-td-probe" \
    "$DRIVER_BUILD_REL/fujinet-nio-baud" \
    "$DRIVER_BUILD_REL/fujinet-nio-serial"
fi
if [[ "$PROFILE" == wb13 ]]; then
  # These commands use only the WB1.3-compatible command/device contract.
  # FMOUNTRESTORE remains a WB2+ utility because it uses SystemTags().
  make -C "$ROOT/repos/nio-core-apps" -f makefiles/build.mk TARGET=amiga \
    "TARGET_BUILD_DIR=build/amiga/$PROFILE" "AMIGA_CRT=$CRT" \
    "FUJINET_NIO_DRIVER_BUILD=$DRIVER_BUILD" \
    build/amiga/$PROFILE/bin/fapp build/amiga/$PROFILE/bin/fboot \
    build/amiga/$PROFILE/bin/fdrive build/amiga/$PROFILE/bin/fhost \
    build/amiga/$PROFILE/bin/fin build/amiga/$PROFILE/bin/fls \
    build/amiga/$PROFILE/bin/fmount build/amiga/$PROFILE/bin/fout \
    build/amiga/$PROFILE/bin/fumount
else
  make -C "$ROOT/repos/nio-core-apps" TARGET=amiga \
    "TARGET_BUILD_DIR=build/amiga/$PROFILE" "AMIGA_CRT=$CRT" \
    "FUJINET_NIO_DRIVER_BUILD=$DRIVER_BUILD"
fi

if [[ "$PROFILE" == wb13 ]]; then
  # These application tests compile and run against the KS1.3 API surface.
  # Diagnostics which use WB2+ DosList lifecycle APIs are built separately
  # once they have an equivalent KS1.3 implementation.
  make -C "$ROOT/repos/nio-apps" -f makefiles/build.mk TARGET=amiga \
    "TARGET_BUILD_DIR=build/amiga/$PROFILE" "AMIGA_CRT=$CRT" \
    "FUJINET_NIO_DRIVER_BUILD=$DRIVER_BUILD" \
    build/amiga/$PROFILE/bin/checksumbench \
    build/amiga/$PROFILE/bin/wificonfigtest \
    build/amiga/$PROFILE/bin/wifitest
else
  make -C "$ROOT/repos/nio-apps" TARGET=amiga \
    "TARGET_BUILD_DIR=build/amiga/$PROFILE" "AMIGA_CRT=$CRT" \
    "FUJINET_NIO_DRIVER_BUILD=$DRIVER_BUILD"
fi

mkdir -p "$STAGE"
for name in fujinet-nio.device fujinet-disk.device fujinet-serial.device \
            fujinet-load-resident fujinet-mount fujinet-nio-exchange; do
  install -m 0644 "$DRIVER_BUILD/$name" "$STAGE/$name"
done

if [[ "$PROFILE" != wb13 ]]; then
  for name in fujinet-unload-resident fujinet-td-probe fujinet-nio-baud \
              fujinet-nio-serial; do
    install -m 0644 "$DRIVER_BUILD/$name" "$STAGE/$name"
  done
fi

for bin_dir in "$CORE_BUILD/bin" "$APPS_BUILD/bin"; do
  for artifact in "$bin_dir"/*; do
    [[ -f "$artifact" ]] || continue
    install -m 0644 "$artifact" "$STAGE/$(basename "$artifact")"
  done
done

if [[ "$PROFILE" == wb13 ]]; then
  install -m 0644 "$ROOT/configs/amiga/install/Install-FujiNet-WB13" \
    "$STAGE/Install-FujiNet-WB13"
  # Keep the staged filename aligned with both the installer and the release
  # manifest.  The default WB1.3 installer refers to this file through the
  # NIO: share, so staging it as DN0-MountList leaves that installer broken.
  install -m 0644 "$ROOT/configs/amiga/install/MountList-FujiNet-WB13" \
    "$STAGE/MountList-FujiNet-WB13"
fi

printf 'Amiga %s artifacts: %s\n' "$PROFILE" "$STAGE"
